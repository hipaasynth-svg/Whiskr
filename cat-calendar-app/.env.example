# ---- Zoho Mail (required) ----
# ZOHO_EMAIL is the real mailbox SMTP logs in as. If you have a dedicated
# mailbox for Whiskr, use it here and skip ZOHO_FROM_EMAIL below.
# Log into that account -> Settings -> Security -> App Passwords -> generate
# one for "Whiskr". Do NOT use your normal Zoho login password — app
# passwords only.
ZOHO_EMAIL=cody@codycarlson.art
ZOHO_APP_PASSWORD=paste-the-16-char-app-password-here
# Optional: set this instead if you're sending as a domain ALIAS on a
# different Zoho account rather than a dedicated mailbox — this repo's own
# setup uses contest@whiskr.lol (no "s") as an alias added under
# cody@codycarlson.art's account. In that case ZOHO_EMAIL/ZOHO_APP_PASSWORD
# above stay set to the real login (cody@codycarlson.art + its own app
# password), and ZOHO_FROM_EMAIL is the alias address mail should appear
# to come from. Leave unset if ZOHO_EMAIL is already the real mailbox
# you're sending as.
ZOHO_FROM_EMAIL=contest@whiskr.lol
# Most accounts use smtp.zoho.com. EU accounts: smtp.zoho.eu  India: smtp.zoho.in
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_FROM_NAME=Whiskr Cat Contest

# ---- Contest / public voting ----
# Rounds run by calendar month, closing at midnight Central time as the month
# ends (see nextRoundWindow in server.js) — not configurable, because the
# rules page promises it. The next round opens automatically; entry is never
# unavailable.
# How many top vote-getters get grouped into each round's internal record
# of results. #1 ("Cat of the Month") wins the original painting directly;
# everyone else entered gets a "you placed #N" email.
CONTEST_WINNERS_COUNT=12
# Anti-fraud vote rate limits (per rolling 24h). Generous enough for a real
# family sharing a link, tight enough to slow down a script or vote farm —
# neither alone stops determined abuse; see also TURNSTILE_* below and the
# admin fraud-review view (public/admin.html) for vote-velocity monitoring.
VOTE_LIMIT_PER_VOTER_PER_DAY=30
VOTE_LIMIT_PER_IP_PER_DAY=60
# Max votes for any ONE cat from one connection for the whole round (stops
# clear-cookies-and-revote). 3 lets a household on shared Wi-Fi each vote.
VOTE_LIMIT_PER_IP_PER_CAT=3
# Same anti-fraud shape, applied to entries and custom print orders — a real
# cat owner never hits either endpoint this many times in a day.
SUBMISSION_LIMIT_PER_IP_PER_DAY=5
CUSTOM_ORDER_LIMIT_PER_IP_PER_DAY=10
# Salts the IP hash stored in the votes table so raw voter IPs are never
# persisted. Set a real random value in production.
IP_HASH_SALT=change-me-to-a-long-random-value
# Optional CAPTCHA on voting (Cloudflare Turnstile — free, no phone-home
# tracking like reCAPTCHA). Without these, /api/vote skips CAPTCHA
# verification entirely (same dry-run-if-unconfigured pattern as
# Stripe/Printful/Zoho elsewhere in this app) — voting still works, just
# with one less anti-bot layer. Get keys at https://dash.cloudflare.com/ ->
# Turnstile -> Add site.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Time-limited discount on the evergreen print shop — issued right after a
# contest entry (ENTRY_DISCOUNT_HOURS) and again in the final-placement
# email for non-winners (FINAL_RANK_DISCOUNT_HOURS, a longer window since
# it's the last-chance nudge). Verified server-side (HMAC + expiry) at
# checkout — see discountToken.js — never trusted from the link alone.
CONTEST_DISCOUNT_PERCENT=20
ENTRY_DISCOUNT_HOURS=48
FINAL_RANK_DISCOUNT_HOURS=72
# Below this on either dimension, an uploaded photo is flagged (not
# blocked — a customer can still buy a print, just with a shown warning)
# as likely to look soft on a large print. Checked with Sharp.
MIN_PRINT_DIMENSION_PX=2000
# How many places an entrant's live rank has to worsen (or crossing out of
# the winner zone) before the daily rank-drop email fires again for them —
# see sendRankDropAlerts in server.js. This is the free, share-driven
# version of contest urgency; there is deliberately no paid-vote path.
RANK_DROP_THRESHOLD=5

# ---- Marketing / ROAS ledger (optional) ----
# The admin marketing panel (admin.html) works with manually-entered ad
# spend even without these set. Setting both turns on automatic daily
# spend pulls from the Meta Marketing API for any campaign in the ledger
# whose name matches a real Meta campaign — see metaAds.js. READ-ONLY:
# nothing this app does can pause a campaign or change its budget, however
# these are configured.
#
# To get these: create a Meta app at developers.facebook.com with Marketing
# API access, add a System User under your Business Settings, generate a
# token for it with the ads_read permission (no ads_management needed,
# since this never writes), and find your ad account ID in Meta Ads
# Manager's URL (looks like act_1234567890 — include the "act_" prefix).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Below this ROAS, an active campaign with at least ROAS_ALERT_MIN_SPEND
# logged gets a plain alert email to ADMIN_EMAIL — never an automatic
# pause or budget change. COOLDOWN_DAYS throttles re-alerting on a
# campaign that stays bad.
ROAS_ALERT_THRESHOLD=2.0
ROAS_ALERT_MIN_SPEND=25
ROAS_ALERT_COOLDOWN_DAYS=3

# Meta Pixel + Conversions API — ad conversion tracking, separate from the
# read-only Marketing API pair above (different Meta product, different
# token permissions). See metaConversions.js. Optional: with these unset,
# the site works exactly as it does today, just without reporting
# entries/checkouts/purchases back to Meta for ad optimization.
#
# META_PIXEL_ID: from Events Manager (business.facebook.com/events_manager)
# — create or open a pixel, the ID is in its settings. Safe to be public;
# it's meant to appear in page source (see /api/config).
#
# META_CAPI_ACCESS_TOKEN: from that same pixel's Settings > Conversions API
# > "Generate access token" — NOT the same token as META_ACCESS_TOKEN
# above (that one only needs ads_read for spend reporting; this one is
# scoped to one specific pixel for sending events). Keep it secret.
#
# META_TEST_EVENT_CODE: optional, from Events Manager's "Test Events" tab
# — set temporarily to see events land in real time while verifying the
# setup, then unset for real traffic (it doesn't stop events from also
# counting normally, but there's no reason to leave it on).
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# The daily check for contests whose voting has closed + due review-request
# emails runs on Vercel Cron (see vercel.json's "crons" entry), not an env
# var — edit the schedule there if you want a different time than 9am UTC.
# Optional: also used to notify you if a paid custom order fails to submit
# to Printful (see submitCustomOrderToPrintful in server.js).
ADMIN_EMAIL=you@whiskr.lol

# ---- Stripe (optional but needed for real checkout) ----
# Get keys from https://dashboard.stripe.com/apikeys — use test keys until you're ready to go live
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From the Stripe Dashboard webhook endpoint you create for
# https://whiskr.lol/api/webhooks/stripe (or `stripe listen` locally),
# subscribed to checkout.session.completed, charge.refunded, and
# charge.dispute.created. Without checkout.session.completed, paid orders
# are never marked paid; without the other two, a refund or dispute never
# gets flagged and a refunded item could still ship.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Countries Stripe Checkout will collect a shipping address for. Keep this
# short — every country you add is one you're committing to handle
# customs/duties questions for. Comma-separated ISO codes, e.g. US,CA.
SHIPPING_COUNTRIES=US

# ---- Printful (custom cat/dog print-on-demand products) ----
# Create a Printful account, add the products in products.js to your store,
# and get a Private Token from Settings -> Stores -> API. Without this,
# custom orders still take payment but printful.js only logs what it would
# have submitted — see README for the full setup, including that every
# printfulVariantId in products.js is a placeholder you must replace.
PRINTFUL_API_KEY=

# ---- AI photo upscaling (optional — improves low-res customer uploads) ----
# Without this, custom orders print exactly the photo the customer
# uploaded, however low-res it is (Printful's own Smart Image Tool only
# nudges borderline-low DPI files, it doesn't fix genuinely blurry/small
# photos — see docs/audit-assembly.md). With it, any custom-order photo
# under PHOTO_ENHANCE_MIN_PX on its long edge gets AI-upscaled via
# Replicate before being submitted to Printful — get a token at
# https://replicate.com/account/api-tokens (pay-per-use, no subscription).
REPLICATE_API_TOKEN=
# Minimum long-edge pixels before a photo is left alone. 1500 is "good
# enough for a mug or phone case," not a full-bleed poster — raise it if
# larger products print soft.
PHOTO_ENHANCE_MIN_PX=1500
# Set to true only after eyeballing real results — GFPGAN's face model is
# trained on human faces and may distort a cat/dog's face unpredictably.
PHOTO_ENHANCE_FACE=false

# ---- Reviews ----
# Days after an order is marked paid before we email asking for a review.
# Give real shipping time — asking too early gets "I haven't received it yet."
REVIEW_REQUEST_DELAY_DAYS=14

# ---- Storage (Vercel-native — set automatically, don't set these by hand) ----
# POSTGRES_URL is injected automatically once you create/link a Postgres
# database to this project in the Vercel dashboard (Storage tab -> Create
# Database). DATABASE_URL also works if your Postgres integration uses that
# name instead. For local development only, point this at a local Postgres:
# POSTGRES_URL=postgres://postgres:postgres@localhost:5432/whiskr_dev
POSTGRES_URL=

# BLOB_READ_WRITE_TOKEN is injected automatically once you create/link a
# Blob store to this project (same Storage tab -> Create Database -> Blob).
# Without it, uploaded photos fall back to local disk, which is fine for
# local development but does NOT work once deployed to Vercel (that
# filesystem isn't writable/persistent) — this must be set in production.
BLOB_READ_WRITE_TOKEN=

# Protects GET /api/cron/daily so only Vercel's own scheduled cron (see
# vercel.json) can trigger it, not a random request to the same URL. Vercel
# automatically sends this same value back as a Bearer token when it fires
# the cron job, once you've set it here.
CRON_SECRET=change-me-to-a-third-long-random-value

# ---- Amazon Associates (optional, for blog affiliate links) ----
# Your Associates tracking ID, e.g. whiskr-20. Every Amazon link in a blog
# post (content/blog/*.md) automatically gets this appended as ?tag=, plus
# rel="sponsored nofollow noopener", and any post containing one
# automatically renders the Associates/FTC disclosure — see blog.js. Leave
# it unset and the links still work, just untagged (no commission), which is
# the right state until your Associates application is actually approved:
# sending traffic with an unapproved or wrong tag earns nothing.
AMAZON_ASSOCIATE_TAG=

# ---- App ----
PORT=3000
# Set to your real domain in production, e.g. https://whiskr.lol — used to
# build links inside result emails and the Stripe webhook URL check.
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_KEY=change-me-to-something-long-and-random
# Used to sign unsubscribe links — set this to its own long random value
# (don't just reuse ADMIN_KEY in production).
UNSUB_SECRET=change-me-to-a-different-long-random-value

# ---- CAN-SPAM compliance (required before sending real result emails) ----
# Your business's physical mailing address — legally required in the footer
# of any commercial email (the winner/featured result emails carry a
# purchase pitch, so they count). A PO box is fine. Once set, this also
# appears on the public site itself — the shared footer (see GET
# /api/business-info in server.js) and the Contact section of
# privacy.html/terms.html/shipping.html — so it only needs to be set once.
# Leave unset and neither surface shows a broken-looking placeholder; they
# just stay hidden until this is real.
BUSINESS_MAILING_ADDRESS=Whiskr, 123 Main St, Anytown, ST 00000

# ---- Printful shipment tracking ----
# Printful does not sign its webhooks — there is no signature header in
# their documented API surface — so the endpoint is protected by an
# unguessable path segment instead, and every delivery is verified by
# re-fetching the order from Printful rather than trusting the posted body.
# Generate a long random value, then register the webhook with Printful:
#   POST https://api.printful.com/v2/webhooks/shipment_sent
#   {"url": "https://whiskr.lol/api/webhooks/printful/<this value>"}
# Leave unset and the endpoint 404s (the daily poll still picks shipments
# up, just a day later).
# (There is also a PRINTFUL_API_BASE override used by the test suite. It is
# ignored unless NODE_ENV=test, deliberately: every Printful request carries
# the account bearer token, so an override honoured in production would let
# anything able to set an env var redirect that token elsewhere.)
PRINTFUL_WEBHOOK_TOKEN=
# Days past a parcel's estimated delivery with no delivery scan before it's
# flagged in admin for a Printful lost-in-transit claim. Printful accepts
# claims up to 30 days after estimated delivery and covers the reprint and
# reshipping, so this wants to stay well under 30.
STALLED_DAYS_AFTER_ETA=7
# Orders refreshed per daily cron run — one Printful API call each, bounded
# to stay inside the serverless function's time limit.
SHIPMENT_POLL_BATCH=100
# How far back the daily poll looks for orders still awaiting delivery. Past
# this a parcel is beyond Printful's 30-day lost-in-transit claim window, so
# keeping it in the rotation only crowds out orders that can still be saved.
SHIPMENT_POLL_MAX_AGE_DAYS=90
# Days after DELIVERY before asking for a review. The review clock used to
# run from order creation, which is how a parcel still in transit — or lost
# outright — still got a "how did we do?" email.
REVIEW_DELAY_AFTER_DELIVERY_DAYS=3
