# ---- Zoho Mail (required) ----
# Log into Zoho Mail -> Settings -> Mail Accounts -> pick the sending address
# Then Settings -> Security -> App Passwords -> generate one for "Whiskr"
# Do NOT use your normal Zoho login password here — app passwords only.
ZOHO_EMAIL=contests@whiskr.lol
ZOHO_APP_PASSWORD=paste-the-16-char-app-password-here
# Most accounts use smtp.zoho.com. EU accounts: smtp.zoho.eu  India: smtp.zoho.in
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_FROM_NAME=Whiskr Cat Contest

# ---- Contest / judging timing ----
# Deadline (in days) after a group of 12 seals for you to pick a cover cat
# via POST /api/admin/groups/:groupId/pick (or public/admin.html). You can
# judge earlier any time — this is just the fallback: if the deadline
# passes with no manual pick, one is chosen at random so entrants aren't
# left waiting forever.
VOTING_PERIOD_DAYS=21
# How often (cron syntax) the server checks for groups past their judging deadline
CRON_SCHEDULE=0 9 * * *
# Minimum photos required before a group is sealed and the judging deadline starts
GROUP_SIZE=12
# Optional: if set, you get an email whenever the random-fallback above fires
# (i.e. whenever you didn't judge a batch in time) — a signal to judge faster.
ADMIN_EMAIL=you@whiskr.lol

# ---- Stripe (optional but needed for real checkout) ----
# Get keys from https://dashboard.stripe.com/apikeys — use test keys until you're ready to go live
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From the Stripe Dashboard webhook endpoint you create for
# https://whiskr.lol/api/webhooks/stripe (or `stripe listen` locally),
# subscribed to checkout.session.completed. Without this, paid orders are
# never marked paid — you'd have no reliable record of what to fulfill.
STRIPE_WEBHOOK_SECRET=whsec_xxx
CALENDAR_PRICE_USD=24.99
CALENDAR_2PLUS_PRICE_USD=19.99

# ---- App ----
PORT=3000
# Set to your real domain in production, e.g. https://whiskr.lol — used to
# build links inside result emails and the Stripe webhook URL check.
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_KEY=change-me-to-something-long-and-random
# Used to sign unsubscribe links — set this to its own long random value
# (don't just reuse ADMIN_KEY in production).
UNSUB_SECRET=change-me-to-a-different-long-random-value

# ---- CAN-SPAM compliance (required before sending real result emails) ----
# Your business's physical mailing address — legally required in the footer
# of any commercial email (the winner/featured result emails carry a
# purchase pitch, so they count). A PO box is fine.
BUSINESS_MAILING_ADDRESS=Whiskr, 123 Main St, Anytown, ST 00000
